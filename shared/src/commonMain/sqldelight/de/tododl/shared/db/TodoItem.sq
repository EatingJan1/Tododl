CREATE TABLE todoItem (
    id TEXT NOT NULL PRIMARY KEY,
    panelId TEXT NOT NULL, -- verweist auf node.id (ein Panel vom Typ "PANEL_TODOLIST")
    text TEXT NOT NULL,
    done INTEGER NOT NULL DEFAULT 0,
    parentId TEXT,               -- gesetzt = Unteraufgabe von parentId (selbstreferenzierend)
    assigneeUsername TEXT,       -- Person zugeteilt (Server-Nutzername)
    priority TEXT NOT NULL DEFAULT 'NONE', -- NONE|LOW|MEDIUM|HIGH|URGENT
    terminDate INTEGER,          -- Termin (geplanter Tag)
    dueDate INTEGER,             -- Endfrist (hartes Deadline-Datum)
    position INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    FOREIGN KEY (panelId) REFERENCES node(id) ON DELETE CASCADE,
    FOREIGN KEY (parentId) REFERENCES todoItem(id) ON DELETE CASCADE
);

CREATE INDEX todoItem_panel_idx ON todoItem(panelId);
CREATE INDEX todoItem_parent_idx ON todoItem(parentId);

selectTodoItemsByPanel:
SELECT * FROM todoItem WHERE panelId = ? ORDER BY position ASC;

insertTodoItem:
INSERT OR REPLACE INTO todoItem(id, panelId, text, done, parentId, assigneeUsername, priority, terminDate, dueDate, position, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setTodoItemDone:
UPDATE todoItem SET done = ?, updatedAt = ? WHERE id = ?;

deleteTodoItem:
DELETE FROM todoItem WHERE id = ?;
